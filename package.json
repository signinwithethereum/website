{
  "name": "siwe-landing-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "siwe.xyz — the site for Sign in with Ethereum (ERC-4361)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vitepress dev --port 4321",
    "build": "vitepress build",
    "preview": "vitepress preview --port 4321",
    "typecheck": "vue-tsc --noEmit",
    "check:agent-content": "node --experimental-strip-types .vitepress/agent-content.test.ts",
    "og": "pnpm build",
    "kamal:setup": "set -a && . ./.env.production && set +a && kamal setup",
    "kamal:deploy": "set -a && . ./.env.production && set +a && kamal deploy",
    "kamal:logs": "set -a && . ./.env.production && set +a && kamal app logs -f",
    "kamal:api:setup": "set -a && . ./.env.production && set +a && kamal setup -c config/deploy.api.yml",
    "kamal:api:deploy": "set -a && . ./.env.production && set +a && kamal deploy -c config/deploy.api.yml",
    "kamal:api:logs": "set -a && . ./.env.production && set +a && kamal app logs -f -c config/deploy.api.yml"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "geist": "^1.7.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.40",
    "vue-tsc": "^3.1.1"
  }
}
